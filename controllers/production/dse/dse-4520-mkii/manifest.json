  "validation": {
    "documentation": [
      "DSE GenComm standard and Gencomm Control Keys training document 056-051",
      "MODEL_EVIDENCE.md: model-by-model evidence from official Deep Sea Electronics product/download pages",
      "DSE8610 MKII register list supplied by the user and retained as the register-map source",
      "DSE GenComm rule: 32-bit values store the most-significant register at the lowest address"
    ],
    "lab": false,
    "field": true,
    "commandSafety": "Liberação específica do GEN163/G-191: START, STOP/OFF, AUTO, MANUAL e TEST. Cada ação exige firmware 4.8, binding correto, comunicação e disponibilidade da control key na página 16. START também exige RPM parado, modo compatível e ausência de status crítico.",
    "fieldReference": "GEN163 / G-191 / DSE4520 MKII / firmware 4.8 / START GenComm previamente ensaiado em campo e confirmado pelos eletricistas responsáveis em 2026-09-29."
  },
  "notes": "Pack específico do GEN163/G-191 para DSE4520 MKII firmware 4.8. START, STOP/OFF, AUTO, MANUAL e TEST usam GenComm Control Keys com fail-closed por disponibilidade. Transferências e comandos genéricos MCB/GCB permanecem separados por semântica.",
  "commands": {
    "start": {
      "executor": "dse_gencomm_privileged",
      "transport": "modbus_tcp_direct",
      "confirmation": "START",
      "preconditions": [
        "generator_enabled",
        "field_validated_pack",
        "binding_match",
        "controller_online",
        "firmware_4_8",
        "engine_stopped",
        "mode_auto_manual_or_test",
        "gencomm_start_key_available",
        "no_critical_status_bits"
      ],
      "feedback": {
        "metric": "rpm",
        "operator": "gt",
        "value": 50,
        "timeoutSeconds": 15
      },
      "timeoutSeconds": 20,
      "notes": "START do G-191: relê modo, RPM, status e página 16 antes da FC16."
    },
