{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rc-geradores.local/schemas/controller-pack-v3.schema.json",
  "title": "RC Geradores Controller Pack v3",
  "type": "object",
  "required": [
    "schema",
    "manufacturer",
    "family",
    "model",
    "status",
    "application",
    "protocols",
    "transports",
    "capabilities",
    "validatedTelemetry"
  ],
  "properties": {
    "schema": { "const": 3 },
    "manufacturer": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": {
      "type": "string",
      "enum": ["investigation", "documented", "lab_validated", "field_validated", "production"]
    },
    "application": {
      "type": "string",
      "enum": ["genset", "mains", "ats", "bus", "bess", "engine", "light_tower", "field_gateway", "microgrid", "other"]
    },
    "category": { "type": "string" },
    "firmware": {
      "type": "object",
      "properties": {
        "tested": { "type": "array", "items": { "type": "string" } },
        "minimum": { "type": ["string", "null"] },
        "maximum": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "protocols": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "transports": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["reverse_tcp", "modbus_tcp_direct", "rtu_over_tcp", "modbus_rtu_serial"]
      },
      "uniqueItems": true
    },
    "defaults": {
      "type": "object",
      "properties": {
        "batteryNominalVoltage": { "type": ["number", "null"], "minimum": 0 },
        "modbusUnit": { "type": ["integer", "null"], "minimum": 1, "maximum": 247 },
        "tcpPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "rapid": {
      "type": "object",
      "required": ["template", "driver", "channels"],
      "properties": {
        "template": { "type": "string", "minLength": 1 },
        "driver": { "type": "string", "minLength": 1 },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "tagCode", "name", "scale"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "tagCode": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "scale": { "type": "number" },
              "unit": { "type": "string" },
              "source": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": ["telemetry", "start", "stop", "auto", "manual", "test", "mcb_open", "mcb_close", "gcb_open", "gcb_close", "paralleling"],
      "properties": {
        "telemetry": { "type": "boolean" },
        "start": { "type": "boolean" },
        "stop": { "type": "boolean" },
        "auto": { "type": "boolean" },
        "manual": { "type": "boolean" },
        "test": { "type": "boolean" },
        "mcb_open": { "type": "boolean" },
        "mcb_close": { "type": "boolean" },
        "gcb_open": { "type": "boolean" },
        "gcb_close": { "type": "boolean" },
        "paralleling": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "validatedTelemetry": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "validation": {
      "type": "object",
      "properties": {
        "documentation": { "type": "array", "items": { "type": "string" } },
        "lab": { "type": "boolean" },
        "field": { "type": "boolean" },
        "commandSafety": { "type": "string" }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
