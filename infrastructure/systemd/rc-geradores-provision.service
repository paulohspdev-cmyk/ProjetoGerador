[Unit]
Description=RC Geradores Rapid Provision Helper
After=network-online.target scadaserver6.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=rcgeradores
WorkingDirectory=/opt/rc-geradores/backend
EnvironmentFile=-/etc/rc-geradores.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=rc-geradores
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/opt/rc-geradores/backend/.venv/bin/python -m app.provision_service
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL
ReadWritePaths=/run/rc-geradores /var/lib/rc-geradores /var/log/rc-geradores /opt/scada

[Install]
WantedBy=multi-user.target
