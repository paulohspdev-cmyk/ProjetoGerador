# RC Geradores - configuração padrão para VM
RC_DATA_DIR=/var/lib/rc-geradores
RC_DB_FILE=/var/lib/rc-geradores/rc-geradores.db
RC_PROJECT_ROOT=/opt/rc-geradores

# Rapid SCADA é a fonte industrial de telemetria e histórico.
# Em produção os bindings dinâmicos ficam fora do checkout Git.
RC_RAPID_BINDINGS=/var/lib/rc-geradores/rapid-bindings.json
RC_RAPID_READER=/opt/rc-geradores/.rapid-reader/RcRapidReader.dll
RC_RAPID_COMM_CONFIG=/opt/scada/ScadaComm/Config/ScadaCommConfig.xml
RC_RAPID_CACHE_TTL=1.5

# Frontend e API usam a mesma origem HTTPS através do Nginx.
# O instalador acrescenta automaticamente o IP/host local quando aplicável.
RC_CORS_ORIGINS=https://localhost,https://127.0.0.1
RC_PUBLIC_BASE_URL=

# Sessão web e proteção de login. Produção é HTTPS por padrão.
RC_AUTH_COOKIE=rc_session
RC_AUTH_SESSION_TTL=43200
RC_AUTH_COOKIE_SECURE=1
RC_LOGIN_MAX_FAILURES=5
RC_LOGIN_LOCK_SECONDS=900
RC_PASSWORD_RESET_TTL=1800
RC_API_DOCS=0

# RC_ADMIN_PASSWORD nunca deve ser persistida aqui.
# O instalador cria o primeiro administrador por prompt seguro.
RC_ADMIN_NAME=Administrador
RC_ADMIN_EMAIL=admin@rcgeradores.local
RC_ADMIN_PASSWORD=

# Bridge exclusiva para modems/DTUs que iniciam conexão TCP (reverse_tcp).
RC_RAPID_REMOTE_BIND=0.0.0.0
RC_RAPID_LOCAL_BIND=127.0.0.1
RC_RAPID_LOCAL_OFFSET=10000
RC_RAPID_BRIDGE_TIMEOUT=4
RC_RAPID_RECONCILE_SECONDS=5
RC_RAPID_CONTROL_SOCKET=/run/rc-geradores/control.sock

# Helper privilegiado de provisionamento do Rapid SCADA.
RC_PROVISION_SOCKET=/run/rc-geradores/provision.sock

# START/STOP da InteliGen 200 somente pelo socket privilegiado.
# Ativação feita explicitamente pelo instalador com --enable-control.
RC_ENABLE_IG200_CONTROL=0

# Backup completo. Arquivos são gravados dentro de RC_DATA_DIR.
RC_BACKUP_RETENTION=14
# Segredos de /etc/rc-geradores.env NÃO entram no backup por padrão.
# Só habilite em pacote de disaster recovery armazenado/protegido fora do painel.
RC_BACKUP_INCLUDE_SECRETS=0

# SMTP opcional. Deixe host vazio para manter e-mail desabilitado.
RC_SMTP_HOST=
RC_SMTP_PORT=587
RC_SMTP_USER=
RC_SMTP_PASSWORD=
RC_SMTP_FROM=
RC_SMTP_STARTTLS=1

# WhatsApp opcional. O backend usa um provedor HTTP configurado pelo operador.
RC_WHATSAPP_API_URL=
RC_WHATSAPP_API_TOKEN=

# Por segurança webhooks para redes privadas ficam bloqueados por padrão.
RC_ALLOW_PRIVATE_WEBHOOKS=0

# Frontend Node/TanStack Start
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
