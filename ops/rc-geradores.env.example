# RC Geradores - configuração padrão para VM
RC_DATA_DIR=/var/lib/rc-geradores
RC_DB_FILE=/var/lib/rc-geradores/rc-geradores.db
RC_RAPID_BINDINGS=/opt/rc-geradores/rapid/bindings.json
RC_RAPID_READER=/opt/rc-geradores/.rapid-reader/RcRapidReader.dll
RC_RAPID_COMM_CONFIG=/opt/scada/ScadaComm/Config/ScadaCommConfig.xml
RC_RAPID_CACHE_TTL=1.5
RC_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Bridge reversa. Só é usada para transport=reverse_tcp.
RC_RAPID_REMOTE_BIND=0.0.0.0
RC_RAPID_LOCAL_BIND=127.0.0.1
RC_RAPID_LOCAL_OFFSET=10000
RC_RAPID_BRIDGE_TIMEOUT=4
RC_RAPID_RECONCILE_SECONDS=5
RC_RAPID_CONTROL_SOCKET=/run/rc-geradores/control.sock

# Controle industrial permanece desligado até ativação explícita.
RC_ENABLE_IG200_CONTROL=0

# Frontend Node/TanStack Start
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
