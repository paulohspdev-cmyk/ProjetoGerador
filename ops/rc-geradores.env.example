# RC Geradores - configuração padrão para VM
RC_DATA_DIR=/var/lib/rc-geradores
RC_DB_FILE=/var/lib/rc-geradores/rc-geradores.db
RC_PROJECT_ROOT=/opt/rc-geradores
# production ativa validações fail-closed e proíbe caminhos de comando LAB.
RC_ENVIRONMENT=production
# external_proxy = HTTPS/certificado/redirecionamento são gerenciados pelo Nginx Proxy Manager.
RC_WEB_TLS_MODE=external_proxy

RC_RAPID_BINDINGS=/var/lib/rc-geradores/rapid-bindings.json
RC_RAPID_READER=/opt/rc-geradores/.rapid-reader/RcRapidReader.dll
RC_RAPID_COMM_CONFIG=/opt/scada/ScadaComm/Config/ScadaCommConfig.xml
RC_RAPID_CACHE_TTL=1.5
RC_RAPID_READER_TIMEOUT=4
# Portas nativas do Rapid SCADA (Server 10000, Agent 10002 e Webstation 10008).
# Vazio = somente loopback, que é o padrão mais restritivo. Se houver acesso
# administrativo direto por LAN/VPN, informe apenas essas redes confiáveis.
# Nunca use 0.0.0.0/0 ou ::/0.
RC_RAPID_ADMIN_ALLOWED_CIDRS=

RC_CORS_ORIGINS=https://localhost,https://127.0.0.1
# Em external_proxy o NPM conecta diretamente em 3000/8090. Estes CIDRs são
# os únicos peers autorizados pelo firewall nftables nessas portas.
# Exemplo da fábrica auditada: 10.10.10.131/32. Confirme antes de aplicar.
RC_EXTERNAL_PROXY_ALLOWED_CIDRS=
# Somente proxies que realmente conectam à API podem fornecer X-Real-IP.
# Em external_proxy deve cobrir os mesmos peers autorizados acima.
# Nunca use 0.0.0.0/0 ou ::/0.
RC_TRUSTED_PROXY_CIDRS=
RC_PUBLIC_BASE_URL=
RC_TLS_CERT_FILE=
RC_TLS_KEY_FILE=

RC_AUTH_COOKIE=rc_session
RC_AUTH_SESSION_TTL=43200
RC_AUTH_COOKIE_SECURE=1
RC_LOGIN_MAX_FAILURES=5
RC_LOGIN_LOCK_SECONDS=900
RC_PASSWORD_RESET_TTL=1800
RC_API_DOCS=0
# Chave local usada para criptografar segredos TOTP no SQLite.
RC_TOTP_KEY_FILE=/var/lib/rc-geradores/.secrets/totp-fernet.key

RC_ADMIN_NAME=Administrador
RC_ADMIN_EMAIL=admin@rcgeradores.local
RC_ADMIN_PASSWORD=

# Bridge reverse TCP. Allowed CIDRs vazio mantém compatibilidade com modem de IP dinâmico;
# quando houver IP/rede conhecida, configure explicitamente para bloquear outras origens.
RC_RAPID_REMOTE_BIND=0.0.0.0
RC_RAPID_REMOTE_ALLOWED_CIDRS=
# Override opcional por listener: RC_RAPID_REMOTE_ALLOWED_CIDRS_<PORTA>.
# O override da porta tem prioridade sobre a lista global e permite restringir cada modem
# à sua própria origem. Exemplo (não copiar sem confirmar a rede real de campo):
# RC_RAPID_REMOTE_ALLOWED_CIDRS_15001=203.0.113.10/32
# RC_RAPID_REMOTE_ALLOWED_CIDRS_15002=198.51.100.0/28
# Com REQUIRE_ALLOWLIST=1, toda porta reverse TCP ativa sem lista global ou específica
# fica bloqueada (fail-closed).
RC_RAPID_REQUIRE_ALLOWLIST=0
RC_RAPID_CONNECT_RATE_LIMIT=30
RC_RAPID_REPLACE_ACTIVE_AFTER=30
RC_RAPID_LOCAL_BIND=127.0.0.1
RC_RAPID_LOCAL_OFFSET=10000
# Override físico por porta compartilhada. Use somente quando o framing real do modem/DTU
# for conhecido e uniforme para todos os Units daquela porta.
# Ex.: 15002 usa Modbus TCP/MBAP; 15003 é RTU transparente sobre TCP.
RC_RAPID_PORT_FRAMING_OVERRIDES=
# A bridge encerra uma tentativa individual antes do timeout do Device no Rapid.
RC_RAPID_BRIDGE_TIMEOUT=4
# Unit que não responde entra em cooldown exponencial sem derrubar os outros Units da mesma porta.
RC_RAPID_UNIT_BACKOFF_BASE=5
RC_RAPID_UNIT_BACKOFF_MAX=30
# Deve permanecer maior que RC_RAPID_BRIDGE_TIMEOUT. O backend valida essa margem.
RC_MODBUS_DEVICE_TIMEOUT_MS=5500
RC_MODBUS_POLL_DELAY_MS=1000
RC_RAPID_RECONCILE_SECONDS=5
RC_RAPID_CONTROL_SOCKET=/run/rc-geradores/control.sock
RC_BRIDGE_STATUS_FILE=/run/rc-geradores/bridge-status.json
RC_BRIDGE_STATUS_STALE_SECONDS=15

RC_PROVISION_SOCKET=/run/rc-geradores/provision.sock
# Em timeout o helper encerra o grupo do processo antes de liberar o lock privilegiado.
RC_PROVISION_OPERATION_TIMEOUT=90
RC_PROVISION_TERMINATE_GRACE=5
RC_ENABLE_IG200_CONTROL=0

# Ferramentas LAB nunca devem ficar ativas com RC_ENVIRONMENT=production.
RC_ENABLE_DSE_LAB_CONTROL=0
RC_DSE_LAB_ALLOWLIST=

# Homologação de campo IG4 200. Permanece desligada por padrão e não altera o
# manifest de produção. Quando habilitada, a allowlist deve conter TAG/ID exato
# do único gerador liberado para START LAB, por exemplo GEN204.
RC_ENABLE_IG4_LAB_CONTROL=0
RC_IG4_LAB_ALLOWLIST=
RC_IG4_LAB_CONTROL_SOCKET=/run/rc-geradores/ig4-lab-control.sock

RC_BACKUP_RETENTION=14
RC_BACKUP_INCLUDE_SECRETS=0
# Opcional: diretório em volume/host externo. Nunca é usado sem criptografia.
RC_BACKUP_OFFSITE_DIR=
# Arquivo contendo uma chave Fernet existente e guardada fora da VM.
RC_BACKUP_OFFSITE_KEY_FILE=
# Se 1, backup será considerado falho enquanto o destino off-site não estiver configurado/gravável.
RC_BACKUP_OFFSITE_REQUIRED=0

# Política de retenção do banco do produto.
RC_RETENTION_AUDIT_DAYS=730
RC_RETENTION_PROCESS_DAYS=365
RC_RETENTION_EVENT_DAYS=365
RC_RETENTION_NOTIFICATION_DAYS=180
RC_RETENTION_BRIDGE_PEER_DAYS=90

RC_SMTP_HOST=
RC_SMTP_PORT=587
RC_SMTP_USER=
RC_SMTP_PASSWORD=
RC_SMTP_FROM=
RC_SMTP_STARTTLS=1
RC_WHATSAPP_API_URL=
RC_WHATSAPP_API_TOKEN=
RC_ALLOW_PRIVATE_WEBHOOKS=0

HOST=127.0.0.1
PORT=3000
NODE_ENV=production
