[Unit]
Description=RC Geradores Reverse TCP Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rcgeradores
Group=rcgeradores
WorkingDirectory=/opt/rc-geradores/backend
EnvironmentFile=-/etc/rc-geradores.env
RuntimeDirectory=rc-geradores
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/opt/rc-geradores/backend/.venv/bin/python -m app.bridge_runtime
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/rc-geradores /var/log/rc-geradores /run/rc-geradores

[Install]
WantedBy=multi-user.target
