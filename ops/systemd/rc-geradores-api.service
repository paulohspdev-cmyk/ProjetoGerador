[Unit]
Description=RC Geradores API
After=network-online.target scadaserver6.service
Wants=network-online.target

[Service]
Type=simple
User=rcgeradores
Group=rcgeradores
WorkingDirectory=/opt/rc-geradores/backend
EnvironmentFile=-/etc/rc-geradores.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/rc-geradores/backend/.venv/bin/python /opt/rc-geradores/ops/migrate_db.py
ExecStart=/opt/rc-geradores/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateDevices=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/rc-geradores /var/log/rc-geradores

[Install]
WantedBy=multi-user.target
