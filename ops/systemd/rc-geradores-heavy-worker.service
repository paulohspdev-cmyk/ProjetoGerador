[Unit]
Description=RC Geradores Heavy Worker
After=network-online.target rc-geradores-api.service scadaserver6.service
Wants=network-online.target

[Service]
Type=simple
User=rcgeradores
Group=rcgeradores
WorkingDirectory=/opt/rc-geradores/backend
EnvironmentFile=-/etc/rc-geradores.env
ExecStart=/opt/rc-geradores/backend/.venv/bin/python -m app.heavy_worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/rc-geradores /var/log/rc-geradores

[Install]
WantedBy=multi-user.target
