[Unit]
Description=RC Geradores Frontend
After=network-online.target rc-geradores-api.service
Wants=network-online.target

[Service]
Type=simple
User=rcgeradores
Group=rcgeradores
WorkingDirectory=/opt/rc-geradores
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/etc/rc-geradores.env
ExecStart=/usr/bin/node /opt/rc-geradores/.output/server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
